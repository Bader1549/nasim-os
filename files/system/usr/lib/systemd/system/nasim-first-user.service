[Unit]
Description=Nasim OS: create a passwordless user if the installer made none
Before=plasmalogin.service display-manager.service
After=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/nasim-first-user
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
